<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Deliberately the only entitlement. No network client, no file access outside the
      container, no camera, no microphone, no private API. Together with the absence of any
      TCC-requesting API in the source, this means the app asks the user for nothing.
      Keep it this way: adding a capability here is the only way to widen the attack surface.
    -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
</dict>
</plist>